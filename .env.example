# Copy this file to .env. The Fubon API key should be market-data-only.
MARKET_DATA_PROVIDER=fubon
FUBON_PERSONAL_ID=
FUBON_API_KEY=
FUBON_CERT_PATH=
FUBON_CERT_PASSWORD=
# Set to 1 only after verifying the key has market-data scope and no trading scope.
FUBON_MARKET_DATA_ONLY_CONFIRMED=0

# Enable only when a signed agreement explicitly grants public redisplay.
FUBON_REDISPLAY_LICENSED=0

# Optional benchmark overrides. Leave blank to use provider discovery.
FUBON_TAIEX_SYMBOL=
FUBON_TPEX_SYMBOL=

# Optional alternate Fugle MarketData v1 provider.
FUGLE_API_KEY=
FUGLE_REDISPLAY_LICENSED=0
FUGLE_TAIEX_SYMBOL=
FUGLE_TPEX_SYMBOL=
